<odoo>
  <data>
    <record id="view_move_line_form_inherit_custom" model="ir.ui.view">
      <field name="name">account.move.line.form.inherit.custom</field>
      <field name="model">account.move.line</field>
      <field name="inherit_id" ref="account.view_move_line_form"/>
      <field name="arch" type="xml">
        <xpath expr="//field[@name='quantity']" position="rafter">
          <group string="Custom Line Info" col="4">
          <field name="custom_sn"/>
          <field name="custom_item"/>
          <field name="custom_description"/>
          <field name="custom_qty"/>
          <field name="custom_unit"/>
          <field name="custom_rate"/>
          <field name="custom_discount"/>
          <field name="custom_amount" readonly="1"/>
          <field name="custom_vat_percent"/>
          <field name="custom_vat_amount" readonly="1"/>
          <field name="custom_total_price" readonly="1"/>
          </group>
        </xpath>
      </field>
    </record>
  </data>
</odoo>
