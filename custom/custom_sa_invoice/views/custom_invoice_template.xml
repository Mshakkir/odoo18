
<odoo>
  <template id="report_invoice_document_inherit_sa" inherit_id="account.report_invoice_document">

    <xpath expr="//div[hasclass('page')]" position="before">
      <div class="mb-3">
    <table style="width:100%; border:none; border-collapse:collapse; font-size:12px; color:#581d35;">
      <tr>
        <!-- English Left -->
        <td style="width:35%; text-align:left; vertical-align:top;">
          <strong>SAMEER SHARAF AL OTAIBI TRADING COMPANY</strong><br/>
          C.R. 4030216154<br/>
          VAT Regd : 311299944700003<br/>
          Al Anwar Centre, Showroom No. 12,<br/>
          Baladiya Street, Jeddah 23334 - Saudi Arabia<br/>
          Tel : 0536122833<br/>
          Email: ssaoe.jeddah@gmail.com
        </td>

        <!-- Center Logo -->
        <td style="width:30%; text-align:center;">
          <img src="/custom_sa_invoice/static/src/img/logo.png"
               style="height:70px; object-fit:contain;" alt="Logo"/>
        </td>

        <!-- Arabic Right -->
        <td style="width:35%; text-align:right; vertical-align:top; direction:rtl;">
          <strong>شركة سمير شرف العتيبي التجارية</strong><br/>
          س.ت: ٤٠٣٠٢١٦١٥٤<br/>
          رقم ضريبة القيمة المضافة: ٣١١٢٩٩٩٤٤٧٠٠٠٠٣<br/>
          مركز الأنوار، رقم محل ١٢، شارع البلدية<br/>
          جدة ٢٣٣٣٤ - المملكة العربية السعودية<br/>
          هاتف: ٠٥٣٦١٢٢٨٣٣<br/>
          Email: ssaoe.jeddah@gmail.com
        </td>
      </tr>
    </table>
  </div>
    </xpath>

    <!-- ✅ Add Arabic Title -->
   <xpath expr="//div[hasclass('page')]" position="inside">
  <div style="background-color:#581d35; color:white; padding:6px 0; text-align:center; margin:10px 0; font-weight:bold; font-size:16px;">
    فاتورة ضريبية / Tax Invoice
  </div>
     <div style="border:1px solid #999; margin-bottom:10px; font-size:12px;">

  <!-- Customer Section -->
  <table style="width:100%; border-collapse:collapse;">
    <tr style="background-color:#d3d3d3;">
      <td colspan="2" style="padding:4px 8px; font-weight:bold;">
        Sold To &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; اسم العميل
      </td>
    </tr>
    <tr>
      <td colspan="2" style="padding:6px 10px;">
        <strong><t t-esc="o.partner_id.name"/></strong><br/><br/>
        <span><strong>VAT NO :</strong> <t t-esc="o.partner_id.vat or 'N/A'"/></span>
      </td>
    </tr>
  </table>

  <!-- Invoice Info Section -->
  <table style="width:100%; border-top:1px solid #999; background-color:#d3d3d3; font-weight:bold;">
    <tr>
      <td style="padding:4px 8px;">Inv #. <t t-esc="o.name"/></td>
      <td style="text-align:center;">رقم الفاتورة</td>
      <td style="padding:4px 8px;">Date : <t t-esc="o.invoice_date.strftime('%d/%b/%Y') if o.invoice_date else ''"/></td>
      <td style="text-align:center;">التاريخ</td>
      <td style="padding:4px 8px;">Delivery Date : <t t-esc="o.custom_delivery_date.strftime('%d/%b/%Y') if o.custom_delivery_date else ''"/></td>
      <td style="text-align:center;">تاريخ التسليم</td>
    </tr>
  </table>
</div>

</xpath>

    <!-- ✅ Replace Table Headers -->
    <xpath expr="//table[@name='invoice_line_table']/thead" position="replace">
      <thead>
      <tr>
         <th> S.N م</th>
        <th> Item الصنف</th>
        <th>Description الوصف</th>
        <th>QTY الكمية</th>
        <th> الوحدة Unit</th>
        <th>S.Rate سعر الوحدة</th>
        <th>Disc خصم</th>
        <th>Amount مبلخ</th>
        <th>VAT% الضريبة</th>
        <th> VAT القىمة الضريبة</th>
        <th>Total Price القىمة الإجمالي</th>
      </tr>
    </thead>
    </xpath>
    <xpath expr="//table[@name='invoice_line_table']/tbody" position="replace">
      <tbody>
    <xpath expr="//table[@name='invoice_line_table']/tbody" position="replace">
  <tbody>
    <t t-foreach="o.invoice_line_ids" t-as="line" t-esc-options='{"widget": "float", "precision_digits": 2}'>
      <tr>
        <td class="text-start"><t t-esc="line.sequence"/></td>
        <td class="text-start"><t t-esc="line.product_id.display_name"/></td>
        <td class="text-start"><t t-esc="line.name"/></td>
        <td class="text-end"><t t-esc="line.quantity"/></td>
        <td class="text-end"><t t-esc="line.product_uom_id.name"/></td>
        <td class="text-end"><t t-esc="line.price_unit"/></td>
        <td class="text-end"><t t-esc="line.discount"/>%</td>
        <td class="text-end"><t t-esc="line.price_subtotal"/></td>
        <td class="text-end">
          <t t-if="line.tax_ids">
            <t t-esc="', '.join(['%.2f' % tax.amount for tax in line.tax_ids])"/>%
          </t>
        </td>
        <td class="text-end">
          <t t-esc="line.price_total - line.price_subtotal"/>
        </td>
        <td class="text-end"><t t-esc="line.price_total"/></td>
      </tr>
    </t>
  </tbody>
</xpath>

  </tbody>
    </xpath>

<xpath expr="//div[@id='right-elements']" position="replace">
  <div class="mt-4">
    <table class="table table-bordered" style="width:100%; font-size:12px; text-align:left;">
      <tr>
        <td style="width:25%;">
          <strong>Delivered by<br/>سلمت بواسطة</strong><br/><br/><br/>
        </td>
        <td rowspan="2" style="width:25%; text-align:center;">
          <img src="/custom_sa_invoice/static/src/img/stamp.png" style="max-height:80px;" />
        </td>
        <td rowspan="2" style="width:25%; text-align:center;">
         <t t-if="o.zatca_qr_code">
           <img t-att-src="'data:image/png;base64,%s' % o.zatca_qr_code.decode('utf-8')" style="max-height:80px;"/>
         </t>
        </td>
        <td style="width:25%;">
          <strong>Total Amount :<br/>المبلغ الإجمالي</strong><br/>
          <span t-esc="o.amount_untaxed"/>
        </td>
      </tr>
      <tr>
        <td>
          <strong>Received by<br/>المستلم</strong><br/><br/><br/>
        </td>
        <td>
          <strong>Discount :<br/>الخصم</strong><br/>

        </td>
      </tr>
      <tr>
        <td colspan="3">
          <strong><t t-esc="o.currency_id.amount_to_text(o.amount_total) + ' Only'"/></strong>
        </td>
        <td>
          <strong>Net Amount :<br/>صافي المجموع</strong><br/>
          <span t-esc="o.amount_untaxed"/>
        </td>
      </tr>
      <tr>
        <td colspan="3"></td>
        <td>
          <strong>VAT (15%) :<br/>ضريبة القيمة المضافة</strong><br/>
          <span t-esc="o.amount_tax"/>
        </td>
      </tr>
      <tr>
        <td colspan="3"></td>
        <td>
          <strong>Grand Total :<br/>المبلغ الإجمالي</strong><br/>
          <span><t t-esc="o.amount_total"/></span>
        </td>
      </tr>
    </table>
  </div>
</xpath>

    <!-- ✅ Add Bank Details + Stamp -->
  <xpath expr="//div[@id='payment_term']" position="after">
  <div class="mt-4" style="margin-top:10px;">
    <table style="width:100%; border:1px solid #000; border-collapse:collapse; font-size:12px;">
      <tr>
        <td style="width:25%; padding:6px 10px; border-right:1px solid #000; text-align:right; font-weight:bold;">
          التفاصيل المصرفية :
        </td>
        <td style="width:75%; padding:6px 10px; text-align:left;">
          <strong>Bank Details :</strong><br/>
          SNB Beneficiary Name : Sameer Sharaf Al-Otibi Trading Co.<br/>
          IBAN : SA29 1000 00 10768366000104
        </td>
      </tr>
    </table>
  </div>
</xpath>



  </template>
</odoo>
