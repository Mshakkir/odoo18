<odoo>
  <template id="report_invoice_document_inherit_sa" inherit_id="account.report_invoice_document">
    <!-- Replace the company header -->
    <xpath expr="//div[@class='page']" position="before">
      <div class="page" style="text-align: center;">
        <h2>فاتورة ضريبية / Tax Invoice</h2>
        <div>
          <strong>Company:</strong> <t t-esc="company.name"/><br/>
          <strong>VAT No:</strong> <t t-esc="company.vat"/><br/>
          <strong>Country:</strong> <t t-esc="company.country_id.name"/>
        </div>
      </div>
    </xpath>

    <!-- Add ZATCA-compliant QR Code -->
    <xpath expr="//div[@class='invoice_line_table']" position="before">
      <div style="text-align: right;">
        <img t-if="o.zatca_qr_code" t-att-src="'data:image/png;base64,%s' % o.zatca_qr_code" width="150" height="150"/>
      </div>
    </xpath>

    <!-- Add Arabic + English column headers -->
    <xpath expr="//thead/tr/th[1]" position="replace">
      <th>Description / الوصف</th>
    </xpath>
    <xpath expr="//thead/tr/th[2]" position="after">
      <th>Quantity / الكمية</th>
      <th>Unit Price / سعر الوحدة</th>
      <th>Total / الإجمالي</th>
    </xpath>

    <!-- Add total in words in Arabic -->
    <xpath expr="//div[@class='total']" position="after">
      <p>
        <strong>Total in Words (Arabic):</strong>
        <t t-esc="o.currency_id.amount_to_text(o.amount_total, lang='ar')"/>
      </p>
    </xpath>

    <!-- Add stamp, bank details, and footer -->
    <xpath expr="//div[@class='footer']" position="replace">
      <div class="footer" style="margin-top: 30px; text-align: left;">
        <p><strong>Bank Name:</strong> Al Rajhi Bank</p>
        <p><strong>IBAN:</strong> SA12345678901234567890</p>
        <img src="/custom_sa_invoice/static/src/img/stamp.png" width="100"/>
      </div>
    </xpath>
  </template>
</odoo>
