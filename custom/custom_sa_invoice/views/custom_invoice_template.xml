
<odoo>
  <template id="report_invoice_document_inherit_sa" inherit_id="account.report_invoice_document">

    <xpath expr="//div[hasclass('page')]" position="before">
      <div class="text-center">
        <img src="/custom_sa_invoice/static/src/img/header.png" style="width:100%; max-height:120px; object-fit: contain;"/>
      </div>
    </xpath>

    <!-- ✅ Add Arabic Title -->
    <xpath expr="//div[hasclass('page')]" position="inside">
      <div class="text-center mb-2 mt-2">
        <h2 style="font-weight:bold;font-size:20px;">فاتورة ضريبية / Tax Invoice</h2>
      </div>
    </xpath>

    <!-- ✅ Replace Table Headers -->
    <xpath expr="//table[@name='invoice_line_table']/thead" position="replace">
      <thead>
      <tr>
         <th> S.N م</th>
        <th> Item الصنف</th>
        <th>Description الوصف</th>
        <th>QTY الكمية</th>
        <th> الوحدة Unit</th>
        <th>S.Rate سعر الوحدة</th>
        <th>Disc خصم</th>
        <th>Amount مبلخ</th>
        <th>VAT% الضريبة</th>
        <th> VAT القىمة الضريبة</th>
        <th>Total Price القىمة الإجمالي</th>
      </tr>
    </thead>
    </xpath>
    <xpath expr="//table[@name='invoice_line_table']/tbody" position="replace">
      <tbody>
    <t t-foreach="o.invoice_line_ids" t-as="line">
      <tr>
        <td class="text-start"><t t-esc="line.custom_sn"/></td>
        <td class="text-start"><t t-esc="line.custom_item"/></td>
        <td class="text-start"><t t-esc="line.custom_description"/></td>
        <td class="text-end"><t t-esc="line.custom_qty"/></td>
        <td class="text-end"><t t-esc="line.custom_unit"/></td>
        <td class="text-end"><t t-esc="line.custom_rate" /></td>
        <td class="text-end"><t t-esc="line.custom_discount" />%</td>
        <td class="text-end"><t t-esc="line.custom_amount" /></td>
        <td class="text-end"><t t-esc="line.custom_vat_percent" />%</td>
        <td class="text-end"><t t-esc="line.custom_vat_amount" /></td>
        <td class="text-end"><t t-esc="line.custom_total_price" /></td>
      </tr>
    </t>
  </tbody>
    </xpath>

<xpath expr="//div[@id='right-elements']" position="replace">
  <div class="mt-4">
    <table class="table table-bordered" style="width:100%; font-size:12px; text-align:left;">
      <tr>
        <td style="width:25%;">
          <strong>Delivered by<br/>سلمت بواسطة</strong><br/><br/><br/>
        </td>
        <td rowspan="2" style="width:25%; text-align:center;">
          <img src="/custom_sa_invoice/static/src/img/stamp.png" style="max-height:80px;" />
        </td>
        <td rowspan="2" style="width:25%; text-align:center;">
         <t t-if="o.zatca_qr_code">
           <img t-att-src="'data:image/png;base64,%s' % o.zatca_qr_code.decode('utf-8')" style="max-height:80px;"/>
         </t>
        </td>
        <td style="width:25%;">
          <strong>Total Amount :<br/>المبلغ الإجمالي</strong><br/>
          <span t-esc="o.amount_untaxed"/>
        </td>
      </tr>
      <tr>
        <td>
          <strong>Received by<br/>المستلم</strong><br/><br/><br/>
        </td>
        <td>
          <strong>Discount :<br/>الخصم</strong><br/>
        <span t-esc="o.amount_discount or '0.00'"/>
        </td>
      </tr>
      <tr>
        <td colspan="3">
          <strong><t t-esc="o.currency_id.amount_to_text(o.amount_total) + ' Only'"/></strong>
        </td>
        <td>
          <strong>Net Amount :<br/>صافي المجموع</strong><br/>
          <span t-esc="o.amount_untaxed"/>
        </td>
      </tr>
      <tr>
        <td colspan="3"></td>
        <td>
          <strong>VAT (15%) :<br/>ضريبة القيمة المضافة</strong><br/>
          <span t-esc="o.amount_tax"/>
        </td>
      </tr>
      <tr>
        <td colspan="3"></td>
        <td>
          <strong>Grand Total :<br/>المبلغ الإجمالي</strong><br/>
          <span><t t-esc="o.amount_total"/></span>
        </td>
      </tr>
    </table>
  </div>
</xpath>

    <!-- ✅ Add Bank Details + Stamp -->
    <xpath expr="//div[@id='payment_term']" position="after">
      <div class="mt-4" style="display: flex; justify-content: space-between;">
        <div>
          <p style="margin-bottom:4px;"><strong>Bank Details:/</strong> SNB Beneficairy Name: Sameer Sharaf Al-Otibi Trading Co.(Al Rajhi Bank)</p>
          <p><strong>IBAN:</strong> SA29 1000 00 10768366000104</p>
        </div>
      </div>
    </xpath>


  </template>
</odoo>
