<odoo>
  <template id="report_invoice_document_inherit_sa" inherit_id="account.report_invoice_document">

    <!-- ✅ 1. Add Arabic Title inside the invoice page -->
    <xpath expr="//div[@class='page mb-4']" position="inside">
      <div class="text-center mb-3">
        <h2 style="font-weight:bold;">فاتورة ضريبية / Tax Invoice</h2>
      </div>
    </xpath>

    <!-- ✅ 2. Replace invoice item table with Arabic-English columns -->
    <xpath expr="//table[@name='invoice_line_table']/thead/tr" position="replace">
      <tr>
        <th class="text-start">Description / الوصف</th>
        <th class="text-end">Quantity / الكمية</th>
        <th class="text-end">Unit Price / سعر الوحدة</th>
        <th class="text-end">Taxes / الضريبة</th>
        <th class="text-end">Total / الإجمالي</th>
      </tr>
    </xpath>

    <!-- ✅ 3. Add ZATCA QR code before invoice lines -->
    <xpath expr="//table[@name='invoice_line_table']" position="before">
      <div class="text-end mb-2">
        <img t-if="o.zatca_qr_code" t-att-src="'data:image/png;base64,%s' % o.zatca_qr_code" width="120" height="120"/>
      </div>
    </xpath>

    <!-- ✅ 4. Add Arabic total in words below total -->
    <xpath expr="//div[@id='right-elements']" position="inside">
      <p class="text-end mt-2">
        <strong>Total in Arabic Words:</strong>
        <t t-esc="o.currency_id.amount_to_text(o.amount_total, lang='ar')"/>
      </p>
    </xpath>

    <!-- ✅ 5. Add Bank details + Stamp in footer -->
    <xpath expr="//div[@id='payment_term']" position="after">
      <div class="mt-4" style="text-align: left;">
        <p><strong>Bank Name:</strong> Al Rajhi Bank</p>
        <p><strong>IBAN:</strong> SA12345678901234567890</p>
        <img src="/custom_sa_invoice/static/src/img/stamp.png" width="100" height="100"/>
      </div>
    </xpath>

  </template>
</odoo>
