<odoo>
  <template id="report_invoice_saudi" inherit_id="account.report_invoice_document">

    <!-- ✅ Inject your custom header inside the external layout page -->
    <xpath expr="//div[contains(@class, 'page')]" position="before">
      <div class="text-center" style="margin-bottom: 20px;">
        <h2>فاتورة ضريبية - Tax Invoice</h2>
      </div>
    </xpath>

    <!-- ✅ Add QR + Stamp + Bank Info at the bottom of the page -->
      <xpath expr="//t[@t-call='web.external_layout']" position="replace">
      <div class="mt-4 text-center">
        <!-- ZATCA QR Code -->
        <img t-att-src="o._generate_qr_code(silent_errors=True)" style="width: 150px;" alt="QR Code"/>
      </div>

      <div class="mt-2 text-center">
        <!-- Stamp Image -->
        <img src="/custom_invoice/static/img/stamp.png" style="height: 100px;" alt="Stamp"/>
      </div>

      <div class="mt-4" style="border-top: 1px solid #ccc; padding-top: 10px;">
        <!-- Bank Info -->
        <p><strong>Bank Name:</strong> Al Rajhi Bank</p>
        <p><strong>IBAN:</strong> SA12345678901234567890</p>
        <p><strong>SWIFT:</strong> RJHISARI</p>
      </div>
    </xpath>

  </template>
</odoo>
