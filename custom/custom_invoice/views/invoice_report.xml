<odoo>
  <template id="report_invoice_saudi" inherit_id="account.report_invoice_with_payments">

    <!-- ✅ Insert custom header image ABOVE the invoice content -->
    <xpath expr="//div[@class='page']" position="before">
      <div class="text-center">
        <img t-att-src="'/custom_sa_invoice/static/src/img/header.png'" style="width:100%;" />
      </div>
    </xpath>

    <!-- ✅ Insert QR, stamp, signature & bank info BELOW -->
    <xpath expr="//div[@class='page']" position="inside">
      <div class="row mt32">
        <div class="col-4 text-left">
          <strong>Delivered by / تم التسليم بواسطة:</strong><br/><br/><br/>
          ____________________________
        </div>
        <div class="col-4 text-center">
          <t t-set="qr_code" t-value="env['report.custom_sa_invoice.qr_helper'].generate_qr_base64(
            company.name, company.vat, o.invoice_date.strftime('%Y-%m-%d %H:%M:%S'), o.amount_total, o.amount_tax)"/>
          <img t-att-src="'/report/barcode/?type=QR&amp;value=' + qr_code" style="width:120px; height:120px;"/><br/>
          <img t-att-src="'/custom_sa_invoice/static/src/img/stamp.png'" style="width:100px;" />
        </div>
        <div class="col-4 text-right">
          <strong>Received by / تم الاستلام بواسطة:</strong><br/><br/><br/>
          ____________________________
        </div>
      </div>

      <div class="mt32">
        <strong>Bank Details:</strong><br/>
        SNB Beneficiary Name: Sameer Sharaf Al-Otaibi Trading Co.<br/>
        IBAN: SA29 1000 00 10768366000104<br/>
        <strong>تفاصيل المصرف:</strong><br/>
        اسم المستفيد: شركة سمير شرف العتيبي للتجارة<br/>
        رقم الآيبان: SA29 1000 00 10768366000104
      </div>
    </xpath>

  </template>
</odoo>
