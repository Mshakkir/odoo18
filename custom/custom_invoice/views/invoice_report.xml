<odoo>
  <template id="report_invoice_saudi" inherit_id="account.report_invoice_document">
    <xpath expr="//t[@t-call='web.external_layout']" position="replace">
      <t t-call="web.external_layout">
        <div class="page">
          <!-- ✅ Your custom dual language header, ZATCA QR, stamp, etc. -->
          <h2 class="text-center">فاتورة ضريبية - Tax Invoice</h2>

          <!-- Call original content -->
          <t t-set="o" t-value="o.with_context(lang=lang)"/>
          <t t-call="account.report_invoice_document"/>

          <!-- ✅ Add custom footer (bank info, stamp, etc.) -->
          <div class="mt-5" style="border-top: 1px solid #ddd; padding-top: 10px;">
            <p><strong>Bank Name:</strong> Al Rajhi Bank</p>
            <p><strong>IBAN:</strong> SA12345678901234567890</p>
            <p><strong>SWIFT:</strong> RJHISARI</p>
          </div>

          <!-- ✅ Add ZATCA QR code -->
          <div class="mt-3">
            <img t-att-src="o._generate_qr_code(silent_errors=True)" style="width: 150px;"/>
          </div>

          <!-- ✅ Stamp image -->
          <div class="mt-2">
            <img src="/custom_invoice/static/img/stamp.png" style="height: 100px;" />
          </div>
        </div>
      </t>
    </xpath>
  </template>
</odoo>
